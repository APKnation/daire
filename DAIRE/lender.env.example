# ============================================================
# DAIRE LENDER SUBSYSTEM — .env   (generated 2026-10-01)
# Central System host: 172.17.16.76   Lender host: 172.17.16.70
# For the CRDB copy, change only names/ids/credentials.
# ============================================================

# ---------- Django core ----------
SECRET_KEY=django-insecure-nmb-lender-system-2024-dev-key-change-in-production
DEBUG=True

# FIX #1 — ALLOWED_HOSTS must include Central's IP (172.17.16.76).
# Central broadcasts arrive with "Host: 172.17.16.76:8000"; without this
# entry Django rejects them with HTTP 400 DisallowedHost (this caused the
# FAILED broadcasts at 09:39-09:49 on 2026-10-01).
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,172.17.16.76,172.17.16.70

# ---------- Database ----------
DB_NAME=nmb_lender_db
DB_USER=nmb_user
DB_PASSWORD=nmb_password_2024
DB_HOST=localhost
DB_PORT=5432

# ---------- Lender's own customer auth ----------
JWT_SECRET=nmb-jwt-secret-key-2024-change-in-production

# ---------- DAIRE Central System ----------
# FIX #2 — point directly at Central's LAN address. Do NOT use
# localhost/172.17.16.70 here and do NOT set CENTRAL_API_HOST:
# Central now accepts 172.17.16.76 as a Host header, so the
# old "CENTRAL_API_HOST=localhost" workaround is removed.
DAIRE_API_URL=http://172.17.16.76:8000/api
CENTRAL_LENDER_DATA_URL=http://172.17.16.76:8000/api/lender-data/receive/
CENTRAL_API_TIMEOUT=30

# This lender's id as registered in Central (Lender 1200 = CRDB Bank Plc).
CENTRAL_LENDER_ID=1200

# FIX #3 — fresh key issued by Central for lender 1200 on 2026-10-01
# (the previous CENTRAL_API_KEY did not match Central's stored hash).
# Send it as "X-API-Key" on every outbound request to Central.
CENTRAL_API_KEY=daire_live_b0nKg6ZBjHpf_WTdj_aID4ZW3D0kSoezzcTSoI8iPpU

# Key THIS lender generated for inbound result broadcasts.
# Central presents it as X-API-Key when it broadcasts to this receiver.
# Keep in sync with the receiver's validation logic.
LENDER_CALLBACK_API_KEY=7c3bLX2humlwVZJNwWDl8z5X86JtWQ2O2aRnbnDDDSTDW83

DAIRE_API_KEY=daire-api-key-2024

# ---------- NIDA verification ----------
NIDA_API_URL=http://localhost:8020/api/v1/nida
NIDA_API_TIMEOUT=10

# ============================================================
# RUNTIME REQUIREMENTS (not env vars — read before starting)
# ============================================================
# DEPLOYMENT FACTS (confirmed live 2026-10-01):
# - The NMB lender Django app (nmb_backend.urls) serves on port 8002:
#     POST /api/daire/central/receive/   -> result broadcast  ✅ working
#       (validates the payload, answers {"matched": true, ...})
#     GET  /api/daire/borrowers/         -> borrower lookup  ⚠ requires JWT
# - Central's api_base_url for this lender is registered as
#   http://172.17.16.70:8002 — keep the app on this port and interface.
#
# OPEN ITEM (data pull): /api/daire/borrowers/ rejects Central's requests
# with 401 because it demands a JWT while Central authenticates with
# X-API-Key. Either accept X-API-Key (LENDER_CALLBACK_API_KEY or
# DAIRE_API_KEY) on that route, issue Central a service-account JWT,
# or IP-whitelist 172.17.16.76 — until then only the broadcast leg works.
#
# Verify from Central after (re)starting:
#   curl -X POST http://172.17.16.70:8002/api/daire/central/receive/ \
#        -H 'Content-Type: application/json' -d '{"borrower_reference":"PING"}'
# Expected: 400 JSON validation error (endpoint alive) — not a timeout,
# not an HTML DisallowedHost page.
# ============================================================
